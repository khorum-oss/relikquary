# nginx config for the standalone Relikquary frontend (UI) image. Rendered by the nginx entrypoint
# (envsubst) from /etc/nginx/templates/ — only ${RELIKQUARY_BACKEND} is substituted; nginx runtime
# variables ($uri, $host, …) are left intact.
#
# Strategy (mirrors the vite dev proxy in frontend/vite.config.ts): serve the static SPA for its own
# routes/assets, and reverse-proxy everything else — the API (/api/...) and ANY Maven repository path
# (/releases/..., /snapshots/..., /public/..., etc.) — to the backend.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Artifact uploads are large (Maven jars, OCI blobs) and must not be capped. This MUST stay at
    # server scope: a request is matched against `location /` first, and nginx enforces the body limit
    # there — before the `try_files … @backend` internal redirect reaches the proxy block. Setting it
    # only inside `location @backend` therefore leaves nginx's 1 MB default in force and 413s any large
    # single-PUT upload through this host (HS-13). Server scope makes every location inherit it.
    client_max_body_size 0;

    # SPA app shell at the root.
    location = / {
        try_files /index.html =404;
    }

    # SPA client-side routes (browse UI). Deep links fall back to the app shell.
    location /r/ {
        try_files $uri /index.html;
    }

    # Top-level SPA sections (feature 016). Deep links / refreshes fall back to the app shell instead of
    # being proxied to the backend as if they were repository paths.
    location ~ ^/(dashboard|publish|users|settings)(/|$) {
        try_files $uri /index.html;
    }

    # Static build assets if present, otherwise treat as a backend (API / repository) request.
    location / {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass ${RELIKQUARY_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream the body straight through instead of buffering it to disk first. The size cap is lifted
        # at server scope above, so every location inherits it — not just this one.
        proxy_request_buffering off;
    }
}
